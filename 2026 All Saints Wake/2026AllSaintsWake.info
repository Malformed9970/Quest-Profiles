-- All-seeing Gourd (EventItem 2003819) fires Action 1276: ground-targeted, 10y range, 2y radius.
-- Using it on an entity only opens the placement reticle, so throw at the target's position instead.
LjAsw2026 = LjAsw2026 or {}
LjAsw2026.questId = 5468
LjAsw2026.mapId = 1369
LjAsw2026.gourdId = 2003819
LjAsw2026.throwRange = 9
LjAsw2026.retryMs = 3000
LjAsw2026.lastThrow = LjAsw2026.lastThrow or 0
LjAsw2026.attempts = LjAsw2026.attempts or 0
LjAsw2026.targets = {
	[1058691] = { step = 3, x = 62.28433, y = 39.28275, z = -71.73069, filter = "contentid=1058691,maxdistance=15" },
	[1058694] = { step = 4, field = "I8EH", mask = 8, x = -6.9612155, y = 30.506763, z = -15.735224, filter = "contentid=1058694,maxdistance=15" },
	[1058697] = { step = 4, field = "I8EH", mask = 1, x = 17.074984, y = 27.797003, z = 21.660215, filter = "contentid=1058697,maxdistance=15" },
	[1058696] = { step = 4, field = "I8EH", mask = 2, x = 18.068731, y = 23.458454, z = 82.79231, filter = "contentid=1058696,maxdistance=15" },
	[1058698] = { step = 4, field = "I8EL", mask = 8, x = -148.943, y = 15.977499, z = 103.98318, filter = "contentid=1058698,maxdistance=15" },
	[1058695] = { step = 4, field = "I8EH", mask = 4, x = -51.269585, y = 14.663007, z = -18.691267, filter = "contentid=1058695,maxdistance=15" },
}

function LjAsw2026.Throw(contentId, target)
	if not IsOnMap(LjAsw2026.mapId) or Player:IsMoving() or MIsCasting() or MIsLoading() or IsPositionLocked() then
		return
	end
	if TimeSince(LjAsw2026.lastThrow) < LjAsw2026.retryMs then
		return
	end

	local pos = target
	local el = EntityList(target.filter)
	if table.valid(el) then
		local _, entity = next(el)
		pos = entity.pos
	end
	local ppos = Player.pos
	if PDistance3D(ppos.x, ppos.y, ppos.z, pos.x, pos.y, pos.z) > LjAsw2026.throwRange then
		return
	end
	if Player.ismounted then
		Dismount()
		return
	end

	local item, action = GetItem(LjAsw2026.gourdId)
	if not item then
		d("[LjAsw2026] No All-seeing Gourd in inventory.")
		LjAsw2026.lastThrow = Now()
		return
	end
	if action and action.isoncd then
		return
	end

	LjAsw2026.attempts = LjAsw2026.attempts + 1
	local caster = (LjAsw2026.attempts % 2 == 0 and action) or item
	Player:SetFacing(pos.x, pos.y, pos.z)
	caster:Cast(pos.x, pos.y, pos.z)
	LjAsw2026.lastThrow = Now()
	d("[LjAsw2026] Gourd thrown at " .. tostring(contentId) .. " (attempt " .. tostring(LjAsw2026.attempts) .. ")")
end

function LjAsw2026.Seek(contentId)
	local target = LjAsw2026.targets[contentId]
	if GetQuestInfo(LjAsw2026.questId, "step") ~= target.step then
		return true
	end
	if target.field and bit.band(GetQuestInfo(LjAsw2026.questId, target.field), target.mask) ~= 0 then
		return true
	end
	LjAsw2026.Throw(contentId, target)
	return false
end

